{
  "name": "devconnector",
  "version": "1.0.0",
  "description": "Social network for developers",
  "main": "server.js",
  "scripts": {
    "start": "node server",
    "server": "nodemon server",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client"
  },
  "author": "Lisa Gorewit-Decker",
  "license": "MIT",
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "axios": "0.33.0",
    "bcryptjs": "^2.4.3",
    "config": "^3.3.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^6.8.1",
    "gravatar": "^1.8.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "6.13.10",
    "normalize-url": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "underscore": "1.13.8",
    "serialize-javascript": ">=7.0.5",
    "nth-check": "3.0.1",
    "postcss": "8.5.26",
    "uuid": ">=11.1.1",
    "svgo": "2.8.3",
    "webpack-dev-server": "5.2.6",
    "@tootallnate/once": "2.0.1"
  }
}
